# Optional: everything here can be set in the app (设置 → AI 服务). Values here override the app.
# Copy this file to .env.local to use it. Never commit .env.local.
# Any OpenAI-compatible chat API works. Default: DeepSeek (https://platform.deepseek.com).
RADAR_AI_KEY=
RADAR_AI_BASE_URL=https://api.deepseek.com
RADAR_AI_MODEL=deepseek-flash

# Optional
# RADAR_DATA_DIR=~/.personal-radar        # where radar.db and imported chats live
# CHATLAB_DATA_DIR=~/.chatlab/data       # opt-in: also read chats you already imported into ChatLab (read-only)
# RADAR_PUSH_SUBJECT=mailto:you@example.com  # needed only for iPhone push notifications
