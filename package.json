{
  "name": "personal-radar",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210 -H 127.0.0.1",
    "build": "next build",
    "start": "node bin/radar.mjs",
    "lint": "eslint",
    "import": "node scripts/import.mjs",
    "organize": "node scripts/organize.mjs",
    "milestones": "node scripts/radar-milestones.mjs",
    "check:privacy": "sh scripts/check-privacy.sh",
    "test": "node --test tests/*.test.mjs",
    "serve": "next start -p 3210 -H 127.0.0.1",
    "prepare": "node bin/prepare.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/dates": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/modals": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dayjs": "^1.11.23",
    "next": "16.4.5",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "typescript": "^5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5"
  },
  "description": "Local-first relationship memory: turns your chat exports into reminders, promises and notes about the people you care about.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "personal-radar": "bin/radar.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "scripts/*.mjs",
    "scripts/lib",
    "scripts/*.sh",
    "demo/*/*.json",
    "demo/*/*.mjs",
    "docs",
    "examples",
    "next.config.ts",
    "postcss.config.cjs",
    "tsconfig.json",
    "next-env.d.ts",
    ".env.example",
    "LICENSE",
    "README.md",
    "README.en.md",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/trace",
    "!.next/diagnostics"
  ]
}
