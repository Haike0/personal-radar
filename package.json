{
  "name": "readme-app",
  "version": "1.0.0",
  "description": "ReadMe — local-first memory for the people you care about: finds plans, promises and preferences in your chats and reminds you, every line traced to the original words.",
  "keywords": [
    "local-first",
    "chat",
    "reminders",
    "personal-crm",
    "llm",
    "privacy",
    "line",
    "whatsapp",
    "telegram",
    "imessage",
    "wechat"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Ikarishinji00/personal-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikarishinji00/personal-radar.git"
  },
  "bugs": {
    "url": "https://github.com/Ikarishinji00/personal-radar/issues"
  },
  "bin": {
    "readme-app": "bin/radar.mjs",
    "personal-radar": "bin/radar.mjs"
  },
  "files": [
    "bin",
    "agent",
    "src",
    "public",
    "scripts/*.mjs",
    "scripts/lib",
    "scripts/*.sh",
    "demo/**/*.json",
    "demo/*/*.mjs",
    "docs",
    "examples",
    "next.config.ts",
    "postcss.config.cjs",
    "tsconfig.json",
    "next-env.d.ts",
    ".env.example",
    "LICENSE",
    "README.md",
    ".next/standalone",
    ".next/BUILD_ID",
    "README.ja.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3210 -H 127.0.0.1",
    "build": "next build",
    "start": "node bin/radar.mjs",
    "lint": "eslint",
    "import": "node scripts/import.mjs",
    "organize": "node scripts/organize.mjs",
    "milestones": "node scripts/radar-milestones.mjs",
    "check:privacy": "sh scripts/check-privacy.sh",
    "test": "node --test tests/*.test.mjs",
    "serve": "next start -p 3210 -H 127.0.0.1",
    "prepare": "node bin/prepare.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/dates": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/modals": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dayjs": "^1.11.23",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "next": "16.4.5",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "telegram": "^2.26.22",
    "typescript": "^5",
    "web-push": "^3.6.7"
  }
}
